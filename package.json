{
  "name": "nana",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun run build.ts",
    "test": "bun run test:unit && bun run test:docker",
    "test:unit": "bun test tests/unit",
    "test:unit:coverage": "bun test --coverage tests/unit",
    "test:integration": "bun test --preload ./tests/preload.ts tests/pocketbase tests/api",
    "test:docker": "docker compose -f docker/compose.test.yml up --build --abort-on-container-exit --exit-code-from nana-test"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@elysia/openapi": "^1.4.16",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@scalar/api-reference": "^1.76.0",
    "@sinclair/typebox": "^0.34.52",
    "@uiw/react-md-editor": "^4.1.0",
    "ai": "^6.0.168",
    "ai-sdk-ollama": "^3.8.3",
    "bun-plugin-tailwind": "^0.1.2",
    "elysia": "^1.4.30",
    "jotai": "^2.19.1",
    "jszip": "^3.10.1",
    "pocketbase": "^0.26.8",
    "rate-limiter-flexible": "^11.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.14.2",
    "rehype-sanitize": "^6.0.0",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "source-map-explorer": "^2.5.3"
  },
  "trustedDependencies": [
    "bun"
  ]
}
